# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- AI (Anthropic Claude) ---
# 미설정 시 AI 기능은 규칙 기반 폴백으로 동작합니다.
# 설정 시: 매일 07:00 "오늘의 뉴스"가 Claude 웹 검색으로 실제 뉴스/지수를 조회해 생성됩니다.
# (계정에 웹 검색 도구가 활성화돼 있어야 정확도가 높습니다.)
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"

# --- OAuth (모바일 앱이 ID 토큰을 받아 서버로 전달, 서버가 검증 후 JWT 발급) ---
# 여러 개면 콤마로 구분 (web/ios/android 클라이언트 ID)
GOOGLE_CLIENT_ID=""
APPLE_CLIENT_ID=""

# --- 푸시 알림 (Expo Push Service, Android=FCM / iOS=APNs 로 전달) ---
# 선택: Expo 조직 액세스 토큰 (없어도 발송 가능)
EXPO_ACCESS_TOKEN=""
# 매일 오전 9시 다이제스트 크론 (false 로 비활성화)
DIGEST_CRON_ENABLED="true"
# 매일 오전 7시 "오늘의 뉴스" 자동 생성 크론 (AI 필요, false 로 비활성화)
NEWS_CRON_ENABLED="true"

# 원시 FCM 토큰 직접 발송 (standalone 빌드용). 둘 중 하나 - 미설정 시 원시 FCM 토큰은 건너뜀.
FIREBASE_SERVICE_ACCOUNT=""        # 서비스 계정 JSON 문자열
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-sa.json   # 또는 JSON 파일 경로 (ADC)
