# --- Server ---
PORT=3000
NODE_ENV=development

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# --- Auth ---
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# --- AI (Anthropic Claude) ---
# 미설정 시 AI 기능은 규칙 기반 폴백으로 동작합니다.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5"
